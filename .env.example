# Chave da API da Anthropic — necessária apenas para `make agente` e `make avaliar`
# (o restante do pipeline — coleta, indexação, baseline, smoke test — roda sem chave).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: sobrescrever o modelo do agente/juiz (padrão: claude-opus-4-8)
# EDITAL_AGENT_LLM_MODELO=claude-opus-4-8
# EDITAL_AGENT_LLM_MODELO_JUIZ=claude-opus-4-8
